---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GameNav from "../../components/GameNav.astro";
import { levels } from "../../data/food-run-levels.json";

const totalLevels = levels.length;
---

<BaseLayout title="Food Run! — Ira's Games" description="Pick a player, eat lots of food and find the best food in the world! Grab the Energy Bar, and choose: do you want sugar? A game designed by Ira, age 8.">
  <main class="mx-auto max-w-5xl px-2 sm:px-4 pt-3 pb-10">
    <GameNav current="food-run" title="Food Run!" />
    <p class="rotate-hint text-center text-base font-bold text-[color:var(--crayon-purple)] mb-2">📱 turn your phone sideways for a bigger game!</p>

    <!-- Game stage -->
    <div id="stage" class="sketchy relative bg-white overflow-hidden select-none" style="aspect-ratio: 16 / 9;">
      <canvas id="game" class="absolute inset-0 w-full h-full" width="960" height="540" aria-label="Food Run! game"></canvas>

      <!-- HUD -->
      <div id="hud" class="absolute top-0 inset-x-0 flex items-center gap-2 sm:gap-4 px-3 py-2 text-sm sm:text-lg font-bold pointer-events-none" style="background: rgba(253,249,239,0.85);">
        <span id="hudLevel" class="text-[color:var(--crayon-purple)] truncate">Level 1</span>
        <span class="flex-1"></span>
        <span id="hudStatus" class="text-[color:var(--crayon-green)]"></span>
        <span id="hudFood" class="text-[color:var(--crayon-red)]">food: 0/0</span>
        <span id="hudCoins" class="text-[color:var(--crayon-orange)]">coins: 0</span>
        <button id="btnMusic" class="pointer-events-auto text-lg" aria-label="turn music on or off" style="background:none;border:none;cursor:pointer;font-size:1.3rem;">🔊</button>
      </div>

      <!-- Character picker -->
      <div id="pickerOverlay" class="overlay absolute inset-0 hidden flex-col items-center overflow-y-auto py-2" style="background: rgba(253,249,239,0.95);">
        <div class="m-auto flex flex-col items-center gap-2 sm:gap-4">
          <p id="pickPrompt" class="text-xl sm:text-3xl font-bold text-center" style="transform: rotate(-1deg);">Player 1 — pick your character!</p>
          <div id="charRow" class="flex gap-1 sm:gap-4 flex-wrap justify-center px-1"></div>
          <p class="text-base sm:text-xl opacity-70">tap one to choose</p>
        </div>
      </div>

      <!-- Mode + start screen -->
      <div id="startOverlay" class="overlay absolute inset-0 hidden flex-col items-center justify-center gap-3" style="background: rgba(253,249,239,0.9);">
        <div id="modeSection" class="flex flex-col items-center gap-2 sm:gap-4">
          <p class="text-xl sm:text-3xl font-bold text-[color:var(--crayon-red)]" style="transform: rotate(-2deg);">How many players?</p>
          <div class="flex gap-3 sm:gap-5">
            <button id="btn1P" class="crayon-btn" style="background: var(--crayon-green);">1 player</button>
            <button id="btn2P" class="crayon-btn" style="background: var(--crayon-blue);">2 players!</button>
          </div>
          <button id="btnShopMode" class="crayon-btn" style="background: var(--crayon-orange);">🛍️ Shop</button>
          <p class="hidden sm:block text-lg opacity-70 text-center px-4">eat ALL the food to unlock the best food in the world!</p>
        </div>
        <div id="goSection" class="hidden flex-col items-center gap-2 sm:gap-3 cursor-pointer">
          <p id="startTitle" class="text-lg sm:text-3xl font-bold text-[color:var(--crayon-red)] text-center px-4" style="transform: rotate(-2deg);">Ready?</p>
          <button id="goBtn" class="go-btn text-3xl font-bold text-white" aria-label="go! tap here to start"
            style="border-radius: 9999px; background: var(--crayon-green); border: 4px solid var(--ink); box-shadow: 4px 5px 0 rgba(65,64,60,0.7); transform: rotate(3deg);">
            go!
          </button>
          <p class="hidden sm:block text-xl font-bold">tap here to start</p>
          <div class="flex gap-4 items-center">
            <button id="btnShopGo" class="crayon-btn" style="background: var(--crayon-orange); font-size: 1rem;">🛍️ Shop</button>
            <button id="resetProgress" class="hidden text-base underline opacity-60">start over from level 1</button>
          </div>
        </div>
      </div>

      <!-- Coin shop (shared with Tag Time!) -->
      <div id="shopOverlay" class="overlay absolute inset-0 hidden flex-col items-center overflow-y-auto py-4" style="background: rgba(253,249,239,0.97);">
        <div class="m-auto flex flex-col items-center gap-4">
          <p class="text-2xl sm:text-3xl font-bold text-[color:var(--crayon-orange)]" style="transform: rotate(-2deg);">Ira's Shop! 🛍️</p>
          <p id="shopCoins" class="sketchy bg-white/90 px-5 py-2 text-2xl sm:text-3xl font-bold text-[color:var(--crayon-orange)]" style="transform: rotate(-1deg);" aria-live="polite">
            you have 0 coins 🪙
          </p>
          <div id="shopRow" class="flex gap-3 flex-wrap justify-center px-4 max-w-[880px]"></div>
          <button id="shopBack" class="crayon-btn" style="background: var(--crayon-green);">back</button>
          <p class="text-base opacity-70">every food you eat = 1 coin! coins work in all of Ira's games.</p>
        </div>
      </div>

      <!-- "you want suger?" — Ira's yes / no box -->
      <div id="sugarOverlay" class="overlay fixed inset-0 z-50 hidden flex-col items-center justify-center p-3" style="background: rgba(65,64,60,0.35);" role="dialog" aria-modal="true" aria-labelledby="sugarQuestion">
        <div class="sketchy bg-[color:var(--paper)] px-6 sm:px-10 py-5 flex flex-col items-center gap-3 shadow-[6px_7px_0_rgba(65,64,60,0.5)]" style="transform: rotate(-1deg);">
          <p id="sugarWho" class="text-lg sm:text-xl font-bold opacity-80">you found a whole sack of sugar!</p>
          <div class="sketchy-alt bg-white px-6 py-4 flex items-center gap-4">
            <button id="sugarYes" class="crayon-btn" style="background: var(--crayon-green); font-size: 1.8rem; padding: 0.4em 1.2em;">yes</button>
            <span class="text-xl font-bold">or</span>
            <button id="sugarNo" class="crayon-btn" style="background: var(--crayon-red); font-size: 1.8rem; padding: 0.4em 1.2em;">no</button>
          </div>
          <p id="sugarQuestion" class="text-2xl sm:text-3xl font-bold text-[color:var(--crayon-purple)]">you want suger?</p>
          <p class="text-lg font-bold">
            <span id="sugarCountdown" class="text-3xl text-[color:var(--crayon-red)]">10</span> seconds to choose!
          </p>
          <p id="sugarRoboNote" class="hidden text-base font-bold text-[color:var(--crayon-red)]">psst&hellip; Robo is allergic to sugar! 🤖</p>
          <p class="text-sm opacity-60">yes = super fast&hellip; then slooow! &middot; keys: Y or N</p>
        </div>
      </div>

      <!-- Death -->
      <div id="deathOverlay" class="overlay absolute inset-0 hidden flex-col items-center justify-center gap-2 pointer-events-none" style="background: rgba(224,79,79,0.22);">
        <p id="deathMsg" class="text-3xl sm:text-5xl font-bold text-[color:var(--crayon-red)] text-center px-4" style="transform: rotate(-2deg);">Whoops!</p>
        <p id="deathSub" class="text-lg sm:text-2xl font-bold">back to the flag&hellip;</p>
      </div>

      <!-- Level complete: a small card at the top so you can watch the dance -->
      <div id="levelOverlay" class="overlay absolute inset-x-0 top-12 hidden flex-col items-center pointer-events-none">
        <div class="sketchy bg-[color:var(--paper)]/95 px-6 py-4 flex flex-col items-center gap-2 pointer-events-auto shadow-[4px_5px_0_rgba(65,64,60,0.4)]">
          <p class="text-2xl sm:text-4xl font-bold text-[color:var(--crayon-green)]" style="transform: rotate(-1.5deg);">YUM! You win! ⭐</p>
          <p id="levelStats" class="text-base sm:text-xl font-bold text-center"></p>
          <button id="nextBtn" class="crayon-btn">next level &rarr;</button>
        </div>
      </div>

      <!-- Game complete -->
      <div id="winOverlay" class="overlay absolute inset-0 hidden flex-col items-center justify-center gap-3" style="background: rgba(253,249,239,0.85);">
        <p class="text-3xl sm:text-5xl font-bold text-[color:var(--crayon-orange)] text-center px-4" style="transform: rotate(2deg);">You ate all {totalLevels} levels of food! 🏆</p>
        <p class="text-lg sm:text-2xl font-bold" id="winStats"></p>
        <div class="flex gap-4 flex-wrap justify-center">
          <button id="againBtn" class="crayon-btn">play again!</button>
          <a href="/" class="crayon-btn" style="background: var(--crayon-blue);">🏠 all games</a>
        </div>
      </div>

      <!-- Touch controls: P1 cluster (left) + P2 cluster (right, duo mode only) -->
      <div id="touchControls" class="absolute bottom-0 inset-x-0 hidden justify-between items-end p-4 pointer-events-none">
        <div id="touchClusterP1" class="flex gap-3 pointer-events-auto">
          <button id="btnLeft1" class="touch-btn" aria-label="player 1 move left">&#9664;</button>
          <button id="btnRight1" class="touch-btn" aria-label="player 1 move right">&#9654;</button>
          <button id="btnJump1" class="touch-btn text-xl" style="padding: 0.6em 1.2em;" aria-label="player 1 jump">JUMP</button>
        </div>
        <div id="touchClusterP2" class="flex gap-3 pointer-events-auto hidden">
          <button id="btnLeft2" class="touch-btn" aria-label="player 2 move left">&#9664;</button>
          <button id="btnRight2" class="touch-btn" aria-label="player 2 move right">&#9654;</button>
          <button id="btnJump2" class="touch-btn text-xl" style="padding: 0.6em 1.2em;" aria-label="player 2 jump">JUMP</button>
        </div>
      </div>
    </div>

    <!-- How to play, in kid words -->
    <section class="mt-4 grid gap-3 sm:grid-cols-4 text-center text-base sm:text-lg" aria-label="How to play">
      <div class="sketchy bg-white/70 p-3"><div class="text-3xl">🍎</div>eat <strong>all</strong> the food</div>
      <div class="sketchy-alt bg-white/70 p-3"><div class="text-3xl">⭐</div>then grab the <strong>best food in the world</strong></div>
      <div class="sketchy bg-white/70 p-3"><div class="text-3xl">⚡</div><strong>energy bar</strong> = fast for 10 seconds</div>
      <div class="sketchy-alt bg-white/70 p-3"><div class="text-3xl">🍬</div><strong>sugar?</strong> fast&hellip; then slow!</div>
    </section>
    <p class="mt-3 text-center text-base sm:text-lg">
      1 player: <strong>&larr; &rarr;</strong> or <strong>A D</strong> to move, <strong>space</strong> / <strong>W</strong> / <strong>&uarr;</strong> to jump &middot; or use the buttons on screen
    </p>
    <p class="text-center text-base sm:text-lg opacity-70">
      2 players: P1 = <strong>W A D</strong> + <strong>space</strong> &middot; P2 = <strong>&uarr; &larr; &rarr;</strong> &middot; BOTH players reach the best food to win!
    </p>
    <p class="mt-1 text-center text-base opacity-70">watch out for 🤢 moldy food, 🌶️ hot chilis, 👾 hungry monsters and sticky syrup!</p>
  </main>
</BaseLayout>

<style>
  #stage {
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }
  #stage canvas {
    touch-action: none;
  }
  .overlay {
    touch-action: pan-y;
    overscroll-behavior: contain;
    display: flex;
  }
  .overlay.hidden {
    display: none;
  }
  .touch-btn {
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--ink);
    background: rgba(253, 249, 239, 0.9);
    border: 3px solid var(--ink);
    border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
    padding: 0.5em 0.9em;
    box-shadow: 3px 4px 0 rgba(65, 64, 60, 0.6);
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }
  .touch-btn:active {
    transform: translate(2px, 3px);
    box-shadow: 1px 1px 0 rgba(65, 64, 60, 0.6);
  }
  :global(.char-card) {
    cursor: pointer;
    background: #fff;
    border: 3px solid var(--ink);
    border-radius: 15px 225px 15px 255px / 225px 15px 255px 15px;
    padding: 4px;
    box-shadow: 3px 4px 0 rgba(65, 64, 60, 0.5);
    transition: transform 0.1s ease;
  }
  :global(.char-card:hover), :global(.char-card:focus-visible) {
    transform: translateY(-4px) rotate(-2deg);
  }
  :global(.char-card canvas) {
    display: block;
    width: 110px;
    height: 140px;
  }
  .go-btn {
    width: 110px;
    height: 110px;
  }
  @media (max-width: 640px) {
    .go-btn {
      width: 72px;
      height: 72px;
      font-size: 1.4rem;
    }
    :global(.char-card canvas) {
      width: 46px;
      height: 58px;
    }
    :global(.char-card) {
      padding: 2px !important;
    }
    :global(.char-card div) {
      font-size: 0.9rem !important;
    }
  }
  .rotate-hint {
    display: none;
  }
  @media (orientation: portrait) and (max-width: 640px) {
    .rotate-hint {
      display: block;
    }
    /* On a tall phone the game is small, so the buttons go UNDER the game
       instead of covering it. */
    #stage {
      overflow: visible;
      margin-bottom: 84px;
    }
    #touchControls {
      top: 100%;
      bottom: auto;
      padding: 10px 0 0;
    }
    #touchControls .touch-btn {
      font-size: 1.2rem;
    }
    /* 1 player: arrows on the left thumb, JUMP on the right thumb */
    #touchClusterP1:has(+ #touchClusterP2.hidden) {
      width: 100%;
    }
    #touchClusterP1:has(+ #touchClusterP2.hidden) #btnJump1 {
      margin-left: auto;
    }
    /* 2 players: squeeze both button sets onto one row */
    #touchControls:has(#touchClusterP2:not(.hidden)) > div {
      gap: 6px;
    }
    #touchControls:has(#touchClusterP2:not(.hidden)) .touch-btn {
      font-size: 0.95rem;
      padding: 0.45em 0.65em !important;
    }
  }
</style>

<script>
  import "../../scripts/food-run/main.ts";
</script>
