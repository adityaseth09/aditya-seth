---
import resume from '../data/resume.json';

const { profile } = resume;
const year = new Date().getFullYear();
---

<footer id="contact" class="scroll-mt-20 border-t border-border/70 py-16">
	<div class="section-shell">
		<div class="card-surface reveal relative overflow-hidden p-8 sm:p-12" data-reveal>
			<div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-gradient-to-br from-accent/25 to-accent-2/25 blur-3xl" aria-hidden="true"></div>
			<div class="relative grid items-center gap-8 lg:grid-cols-[1fr_auto]">
				<div>
					<p class="eyebrow">await contact()</p>
					<h2 class="mt-2 font-display text-3xl font-semibold tracking-tight text-text sm:text-4xl">Let's build a checkout people trust.</h2>
					<p class="mt-3 max-w-xl text-base leading-relaxed text-muted">
						{profile.availability}. Based in {profile.location}. The fastest way to reach Neha is email or LinkedIn.
					</p>
				</div>
				<div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
					<a href={`mailto:${profile.email}`} class="btn-primary">
						<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
						{profile.email}
					</a>
					<a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="btn-ghost">LinkedIn profile</a>
					<a href={profile.resumePdf} download class="btn-ghost">Download PDF</a>
				</div>
			</div>
		</div>

		<div class="mt-8 flex flex-col gap-2 font-mono text-[12px] text-muted sm:flex-row sm:items-center sm:justify-between">
			<p>&copy; {year} {profile.name}. Built with Astro, hand-rolled CSS, and no framework on the client.</p>
			<p><a href="/devtools" class="transition hover:text-text">Open in DevTools →</a></p>
		</div>
	</div>
</footer>
