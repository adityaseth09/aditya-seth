---
import ThemeToggle from './ThemeToggle.astro';
import resume from '../data/resume.json';

const { profile, navigation } = resume;
const [first, ...rest] = profile.name.split(' ');
---

<header class="sticky top-0 z-40 border-b border-border/70 bg-background/80 backdrop-blur-md">
	<div class="section-shell flex h-16 items-center justify-between gap-4">
		<a href="#hero" class="font-display text-sm font-semibold tracking-tight text-text transition hover:text-accent sm:text-base">
			<span class="font-mono text-accent">&lt;</span>{first}{' '}<span class="text-muted">{rest.join(' ')}</span><span class="font-mono text-accent"> /&gt;</span>
		</a>

		<nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
			{
				navigation.map((item) => (
					<a href={item.href} class="rounded-lg px-3 py-2 text-sm text-muted transition hover:bg-elevated/70 hover:text-text">
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-2">
			<a
				href={profile.linkedin}
				target="_blank"
				rel="noopener noreferrer"
				class="hidden h-10 items-center rounded-full border border-border px-4 text-sm text-muted transition hover:border-accent/50 hover:text-text sm:inline-flex"
			>
				LinkedIn
			</a>
			<a
				id="devtools-view"
				href="/devtools"
				class="group inline-flex h-10 items-center gap-2 rounded-full border border-border bg-elevated/60 px-3.5 font-mono text-sm text-muted transition hover:border-accent/50 hover:text-text"
				title="Open this résumé in DevTools"
			>
				<svg class="h-4 w-4 text-accent transition group-hover:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="m8 8-4 4 4 4m8-8 4 4-4 4M14 4l-4 16" />
				</svg>
				Inspect
			</a>
			<ThemeToggle />
		</div>
	</div>
</header>
