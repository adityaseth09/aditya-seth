---
import resume from '../data/resume.json';

const { profile, experience } = resume;
const current = experience[0];
const yearsSince = new Date().getFullYear() - 2016;
---

<section id="hero" class="relative overflow-hidden pb-16 pt-12 sm:pb-24 sm:pt-20">
	<div class="grid-paper pointer-events-none absolute inset-0" aria-hidden="true"></div>
	<div class="section-shell relative">
		<div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
			<div class="reveal" data-reveal>
				<div class="mb-5 flex flex-wrap gap-2">
					<p class="inline-flex items-center gap-2 rounded-full border border-border bg-surface/70 px-4 py-1.5 text-sm text-muted">
						<span class="h-2 w-2 rounded-full bg-accent-2"></span>
						{profile.location}
					</p>
					<p class="inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent-soft/60 px-4 py-1.5 text-sm font-medium text-accent">
						<span class="h-2 w-2 animate-pulse rounded-full bg-accent"></span>
						{profile.availability}
					</p>
				</div>

				<h1 class="font-display text-5xl font-semibold leading-[1.02] tracking-tight text-text sm:text-6xl lg:text-7xl">
					<span class="text-gradient">{profile.name}</span>
				</h1>

				<p class="mt-5 max-w-2xl font-display text-xl font-medium text-text sm:text-2xl">
					{profile.title}
					<span class="text-muted"> · {profile.focus}</span>
				</p>

				<p class="mt-4 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">
					{profile.tagline}
				</p>

				<blockquote class="mt-8 max-w-2xl border-l-2 border-accent pl-5 text-base leading-relaxed text-text sm:text-lg">
					{profile.hook}
				</blockquote>

				<div class="mt-10 flex flex-wrap gap-3">
					<a href="/devtools" class="btn-primary">
						<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="m8 8-4 4 4 4m8-8 4 4-4 4M14 4l-4 16" />
						</svg>
						Inspect the résumé
					</a>
					<a href={profile.resumePdf} download class="btn-ghost">Download résumé</a>
					<a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="btn-ghost">LinkedIn</a>
				</div>
			</div>

			<div class="reveal lg:justify-self-end" data-reveal>
				<div class="relative mx-auto w-full max-w-md">
					<div class="absolute -inset-6 rounded-[2.5rem] bg-gradient-to-br from-accent/25 via-transparent to-accent-2/25 blur-3xl" aria-hidden="true"></div>
					<div class="card-surface relative overflow-hidden">
						<div class="browser-chrome">
							<span class="dot bg-crit/80"></span>
							<span class="dot bg-warn/80"></span>
							<span class="dot bg-ok/80"></span>
							<span class="url">
								<svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
								neha.seth.ltd
							</span>
						</div>
						<div class="p-4">
							<div class="relative">
								<img
									src={profile.photo}
									alt={`Portrait of ${profile.name}`}
									width="768"
									height="1024"
									loading="eager"
									decoding="async"
									class="aspect-[4/5] w-full rounded-xl object-cover object-[50%_30%]"
									onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
								/>
								<div
									class="hidden aspect-[4/5] w-full items-center justify-center rounded-xl bg-gradient-to-br from-accent/30 via-elevated to-accent-2/30"
									aria-hidden="true"
								>
									<span class="font-display text-7xl font-semibold text-text">{profile.initials}</span>
								</div>
							</div>

							<pre class="mt-4 overflow-x-auto rounded-xl bg-background/80 p-4 font-mono text-[12.5px] leading-relaxed text-muted"><code><span class="text-accent-2">&lt;</span><span class="text-accent">Engineer</span>
  <span class="text-info">name</span>=<span class="text-ok">"{profile.name}"</span>
  <span class="text-info">focus</span>=<span class="text-ok">"{profile.focus.toLowerCase()}"</span>
  <span class="text-info">stack</span>=<span class="text-accent-2">{`{[`}</span>{profile.stack.map((s, i) => (<Fragment><span class="text-ok">'{s}'</span>{i < profile.stack.length - 1 ? ', ' : ''}</Fragment>))}<span class="text-accent-2">{`]}`}</span>
  <span class="text-info">years</span>=<span class="text-accent-2">{`{`}</span><span class="text-warn">{yearsSince}</span><span class="text-accent-2">{`}`}</span>
  <span class="text-info">currently</span>=<span class="text-ok">"{current.company}"</span>
<span class="text-accent-2">/&gt;</span><span class="caret"></span></code></pre>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
