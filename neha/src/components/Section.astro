---
interface Props {
	id: string;
	eyebrow: string;
	title: string;
	intro?: string;
}

const { id, eyebrow, title, intro } = Astro.props;
---

<section id={id} class="scroll-mt-20 py-16 sm:py-20">
	<div class="section-shell">
		<div class="reveal mb-10 max-w-2xl" data-reveal>
			<p class="eyebrow">{eyebrow}</p>
			<h2 class="mt-2 font-display text-3xl font-semibold tracking-tight text-text sm:text-4xl">{title}</h2>
			{intro && <p class="mt-3 text-base leading-relaxed text-muted">{intro}</p>}
		</div>
		<slot />
	</div>
</section>
