---
import { DATABASE_NAME, TABLES } from '../../lib/db/schema';
import { QUERIES, effectiveAccess } from '../../lib/db/queries';
import { shortType } from '../../lib/db/dialect';

const groups = [...new Set(QUERIES.map((q) => q.group))];
---

<aside class="db-sidebar flex min-w-0 flex-col gap-5" aria-label="Schema explorer and saved queries">
	<div class="card-surface p-3">
		<p class="mb-2 flex items-center justify-between px-2 font-mono text-[11px] uppercase tracking-[0.16em] text-muted">
			<span>Schema</span>
			<span><span data-mysql>SHOW TABLES</span><span data-postgres>\dt</span></span>
		</p>
		<div class="flex items-center gap-2 px-2 py-1 font-mono text-sm text-text">
			<svg class="h-4 w-4 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
				<ellipse cx="12" cy="5.5" rx="8" ry="3" />
				<path d="M4 5.5v6c0 1.66 3.58 3 8 3s8-1.34 8-3v-6" />
				<path d="M4 11.5v6c0 1.66 3.58 3 8 3s8-1.34 8-3v-6" />
			</svg>
			{DATABASE_NAME}
		</div>
		<ul class="mt-1 space-y-0.5 border-l border-border/70 pl-2 ml-4">
			{
				TABLES.map((t) => (
					<li>
						<details class="db-tree-table group" data-table={t.name}>
							<summary class="flex cursor-pointer list-none items-center gap-1.5 rounded-md px-2 py-1 font-mono text-[13px] text-text transition hover:bg-elevated/70">
								<svg class="h-3 w-3 shrink-0 text-muted transition group-open:rotate-90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" d="m9 5 7 7-7 7" />
								</svg>
								<svg class="h-3.5 w-3.5 shrink-0 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
									<rect x="3" y="4" width="18" height="16" rx="2" />
									<path d="M3 10h18M9 10v10" />
								</svg>
								<span class="truncate">{t.name}</span>
								<span class="ml-auto text-[11px] text-muted">{t.rows.length}</span>
							</summary>
							<div class="ml-3 border-l border-border/60 pl-2">
								<button
									type="button"
									class="db-tree-action"
									data-table-pick={t.name}
								>
									SELECT * FROM {t.name}
								</button>
								<button type="button" class="db-tree-action" data-table-ddl={t.name}>
									<span data-mysql>SHOW CREATE TABLE</span><span data-postgres>\d+ {t.name}</span>
								</button>
								<ul class="mt-1 space-y-px pb-1">
									{
										t.columns.map((c) => {
											const idx = t.indexes.find((i) => i.columns[0] === c.name);
											const marker = idx?.kind === 'primary' ? 'PK' : c.references ? 'FK' : idx ? 'IDX' : '';
											return (
												<li class="flex items-center gap-2 px-2 py-0.5 font-mono text-[11.5px]">
													<span class:list={['db-col-marker', marker && `is-${marker.toLowerCase()}`]}>{marker || '·'}</span>
													<span class="truncate text-text/90">{c.name}</span>
													<span class="ml-auto truncate text-muted">
														<span data-mysql>{shortType(c, 'mysql')}</span>
														<span data-postgres>{shortType(c, 'postgres')}</span>
													</span>
												</li>
											);
										})
									}
								</ul>
							</div>
						</details>
					</li>
				))
			}
		</ul>
	</div>

	<div class="card-surface p-3">
		<p class="mb-2 flex items-center justify-between px-2 font-mono text-[11px] uppercase tracking-[0.16em] text-muted">
			<span>Saved queries</span>
			<span>{QUERIES.length}</span>
		</p>
		{
			groups.map((g) => (
				<div class="mb-2 last:mb-0">
					<p class="px-2 py-1 text-[11px] font-medium text-muted">{g}</p>
					<ul class="space-y-0.5">
						{
							QUERIES.filter((q) => q.group === g).map((q) => (
								<li>
									<button type="button" class="db-query-chip" data-query-pick={q.id} aria-pressed="false">
										<span class="db-query-dot" data-access={effectiveAccess(q.plan)}></span>
										<span class="truncate">{q.title}</span>
									</button>
								</li>
							))
						}
					</ul>
				</div>
			))
		}
		<p class="mt-3 flex flex-wrap gap-x-3 gap-y-1 px-2 font-mono text-[10.5px] text-muted">
			<span><span class="db-query-dot inline-block align-middle" data-access="const"></span> PK / index</span>
			<span><span class="db-query-dot inline-block align-middle" data-access="index"></span> index scan</span>
			<span><span class="db-query-dot inline-block align-middle" data-access="all"></span> full scan</span>
		</p>
	</div>
</aside>
