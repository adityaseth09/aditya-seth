---
import ThemeToggle from './ThemeToggle.astro';
import resume from '../data/resume.json';

const { profile, navigation } = resume;
---

<header
	class="sticky top-0 z-40 border-b border-border/70 bg-background/80 backdrop-blur-md"
>
	<div class="section-shell flex h-16 items-center justify-between gap-4">
		<a
			href="#hero"
			class="font-display text-sm font-semibold tracking-tight text-text transition hover:text-accent sm:text-base"
		>
			{profile.name.split(' ')[0]}
			<span class="text-muted">{profile.name.split(' ').slice(1).join(' ')}</span>
		</a>

		<nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
			{
				navigation.map((item) => (
					<a
						href={item.href}
						class="rounded-lg px-3 py-2 text-sm text-muted transition hover:bg-elevated/70 hover:text-text"
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-2">
			<a
				href={profile.linkedin}
				target="_blank"
				rel="noopener noreferrer"
				class="hidden rounded-lg border border-border px-3 py-2 text-sm text-muted transition hover:border-accent/40 hover:text-text sm:inline-flex"
			>
				LinkedIn
			</a>
			<a
				id="sql-view"
				href="/db"
				class="group inline-flex h-10 items-center gap-1.5 rounded-full border border-border bg-elevated/60 px-3 font-mono text-sm text-muted transition hover:border-accent/40 hover:text-text"
				title="View this résumé as a database"
			>
				<svg
					class="h-4 w-4 text-accent transition group-hover:scale-110"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.6"
					aria-hidden="true"
				>
					<ellipse cx="12" cy="5.5" rx="8" ry="3"></ellipse>
					<path d="M4 5.5v6c0 1.66 3.58 3 8 3s8-1.34 8-3v-6"></path>
					<path d="M4 11.5v6c0 1.66 3.58 3 8 3s8-1.34 8-3v-6"></path>
				</svg>
				SQL
			</a>
			<ThemeToggle />
		</div>
	</div>
</header>
