---
import resume from '../data/resume.json';

const { profile, talks } = resume;
---

<section id="hero" class="relative overflow-hidden pb-16 pt-12 sm:pb-20 sm:pt-16">
	<div class="section-shell">
		<div class="grid items-start gap-12 lg:grid-cols-[1.08fr_0.92fr]">
			<div class="reveal" data-reveal>
				<div class="mb-5 flex flex-wrap items-center gap-2.5">
					<p class="inline-flex items-center gap-2 rounded-full border border-border bg-surface/70 px-4 py-1.5 text-sm text-muted">
						<span class="h-2 w-2 rounded-full bg-accent-cyan"></span>
						{profile.location}
					</p>

					<p class="inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent-soft/40 px-4 py-1.5 text-sm font-medium text-accent">
						<span class="h-2 w-2 rounded-full bg-accent animate-pulse"></span>
						{profile.availability}
					</p>
				</div>

				<h1 class="font-display text-4xl font-semibold leading-[1.05] tracking-tight text-text sm:text-5xl lg:text-6xl">
					<span class="text-gradient">{profile.name}</span>
				</h1>

				<p class="mt-5 max-w-2xl text-lg font-medium text-text sm:text-xl">
					{profile.title}
				</p>

				<p class="mt-4 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">
					{profile.tagline}
				</p>

				<blockquote class="mt-8 max-w-2xl border-l-2 border-accent pl-5 text-base leading-relaxed text-text sm:text-lg">
					"{profile.hook}"
				</blockquote>

				<div class="mt-9 flex flex-wrap gap-3">
					<a
						href="#impact"
						class="inline-flex items-center justify-center rounded-full bg-accent px-6 py-3 text-sm font-medium text-white transition hover:brightness-110"
					>
						View impact metrics
					</a>
					<a
						href={profile.resumePdf}
						download
						class="inline-flex items-center justify-center rounded-full border border-border bg-surface/70 px-6 py-3 text-sm font-medium text-text transition hover:border-accent/40"
					>
						Download resume
					</a>
					<a
						href={profile.linkedin}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center justify-center rounded-full border border-border bg-surface/70 px-6 py-3 text-sm font-medium text-text transition hover:border-accent/40"
					>
						Connect on LinkedIn
					</a>
				</div>

				<div class="mt-10 grid gap-3 sm:grid-cols-3">
					<div class="card-surface px-4 py-3.5">
						<p class="text-xs font-medium uppercase tracking-wider text-muted">Focus</p>
						<p class="mt-1 text-sm font-semibold text-text">Optimization at Scale</p>
					</div>
					<div class="card-surface px-4 py-3.5">
						<p class="text-xs font-medium uppercase tracking-wider text-muted">Edge</p>
						<p class="mt-1 text-sm font-semibold text-text">HEC Paris EMBA</p>
					</div>
					<div class="card-surface px-4 py-3.5">
						<p class="text-xs font-medium uppercase tracking-wider text-muted">Languages</p>
						<p class="mt-1 text-sm font-semibold text-text">{profile.languages.join(' · ')}</p>
					</div>
				</div>
			</div>

			<div id="talks" class="reveal scroll-mt-24" data-reveal>
				<div class="relative">
					<div
						class="pointer-events-none absolute -inset-4 rounded-[2rem] bg-gradient-to-br from-accent/20 via-transparent to-accent-cyan/20 blur-2xl"
						aria-hidden="true"
					></div>

					<div class="card-surface relative overflow-hidden p-4 sm:p-5">
						<div class="mb-4 flex items-center justify-between gap-3 px-1">
							<div>
								<p class="text-xs font-semibold uppercase tracking-[0.18em] text-accent">
									Production Evidence
								</p>
								<h2 class="mt-0.5 font-display text-lg font-semibold tracking-tight text-text sm:text-xl">
									Featured Conference Talks
								</h2>
							</div>
							<span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-elevated/80 px-3 py-1 text-xs font-medium text-muted">
								<span class="h-2 w-2 rounded-full bg-crit"></span>
								YouTube Keynotes
							</span>
						</div>

						<div class="grid gap-4">
							{
								talks.map((talk) => (
									<article class="group overflow-hidden rounded-xl border border-border bg-elevated/40 transition hover:border-accent/40 hover:bg-elevated/70">
										<a
											href={talk.url}
											target="_blank"
											rel="noopener noreferrer"
											aria-label={`Watch "${talk.title}" on YouTube`}
											class="relative block aspect-video w-full overflow-hidden bg-slate-950"
										>
											<img
												src={talk.thumbnail}
												data-fallback={talk.fallbackThumbnail}
												alt={`${talk.title} — ${talk.conference}`}
												width="640"
												height="360"
												loading="eager"
												decoding="async"
												class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
												onerror="if (this.dataset.fallback && this.src !== this.dataset.fallback) { this.src = this.dataset.fallback; }"
											/>
											<div
												class="pointer-events-none absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-950/25 to-slate-950/40"
												aria-hidden="true"
											/>

											<div class="absolute left-3 top-3 flex flex-wrap items-center gap-1.5">
												<span class="rounded-full bg-slate-950/80 px-2.5 py-1 text-[11px] font-semibold tracking-wide text-white backdrop-blur-md">
													{talk.conference}
												</span>
												<span class="rounded-full bg-white/15 px-2.5 py-1 text-[11px] font-medium text-slate-100 backdrop-blur-md">
													{talk.location}
												</span>
											</div>

											<div
												class="absolute inset-0 flex items-center justify-center"
												aria-hidden="true"
											>
												<span class="flex h-12 w-12 items-center justify-center rounded-full bg-accent/90 text-white shadow-lg ring-4 ring-white/20 backdrop-blur-sm transition duration-300 group-hover:scale-110 group-hover:bg-accent">
													<svg
														class="ml-0.5 h-5 w-5"
														viewBox="0 0 24 24"
														fill="currentColor"
													>
														<path d="M8 5v14l11-7z" />
													</svg>
												</span>
											</div>
										</a>

										<div class="p-3.5 sm:p-4">
											<h3 class="font-display text-base font-semibold leading-snug text-text">
												<a
													href={talk.url}
													target="_blank"
													rel="noopener noreferrer"
													class="transition hover:text-accent"
												>
													{talk.title}
												</a>
											</h3>

											<div class="mt-2.5 flex flex-wrap gap-1.5">
												{talk.tags.map((tag) => (
													<span class="rounded-md border border-border/80 bg-surface/80 px-2 py-0.5 text-[11px] font-medium text-muted">
														{tag}
													</span>
												))}
											</div>

											<div class="mt-3.5 flex flex-wrap items-center justify-between gap-2 border-t border-border/70 pt-3 text-xs font-medium">
												<a
													href={talk.url}
													target="_blank"
													rel="noopener noreferrer"
													class="inline-flex items-center gap-1.5 text-accent transition hover:underline"
												>
													<svg
														class="h-3.5 w-3.5"
														viewBox="0 0 24 24"
														fill="currentColor"
														aria-hidden="true"
													>
														<path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.4 31.4 0 0 0 0 12a31.4 31.4 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.4 31.4 0 0 0 24 12a31.4 31.4 0 0 0-.5-5.8zM9.6 15.6V8.4l6.3 3.6-6.3 3.6z" />
													</svg>
													Watch on YouTube
												</a>

												{talk.conferenceUrl && (
													<a
														href={talk.conferenceUrl}
														target="_blank"
														rel="noopener noreferrer"
														class="inline-flex items-center gap-1 text-muted transition hover:text-text"
													>
														<span>{talk.conferenceLabel ?? 'Conference Page'}</span>
														<svg
															class="h-3.5 w-3.5"
															viewBox="0 0 24 24"
															fill="none"
															stroke="currentColor"
															stroke-width="2"
															aria-hidden="true"
														>
															<path d="M7 17L17 7M7 7h10v10" />
														</svg>
													</a>
												)}
											</div>
										</div>
									</article>
								))
							}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
