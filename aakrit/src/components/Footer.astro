---
import site from '../data/site.json';

const year = new Date().getFullYear();
---

<footer class="border-t border-border/60 bg-surface/60">
	<div class="section-shell flex flex-col gap-8 py-12">
		<div class="flex flex-wrap items-start justify-between gap-8">
			<div class="max-w-sm">
				<a href="#main" class="flex items-center gap-2.5 font-display text-[15px] font-bold text-text">
					<span class="flex h-8 w-8 items-center justify-center rounded-lg border border-border bg-elevated text-[17px] leading-none text-accent">♞</span>
					{site.profile.name}
				</a>
				<p class="mt-3 text-[13px] leading-relaxed text-muted">
					{site.profile.title} &middot; {site.profile.location}. Online chess coaching for kids and teens in English, German and Hindi.
				</p>
			</div>
			<nav class="grid grid-cols-2 gap-x-10 gap-y-2 text-[13px] text-muted sm:grid-cols-3" aria-label="Footer">
				<a class="transition hover:text-text" href="#about">About</a>
				<a class="transition hover:text-text" href="#achievements">Achievements</a>
				<a class="transition hover:text-text" href="#journey">Journey</a>
				<a class="transition hover:text-text" href="#coaching">Coaching</a>
				<a class="transition hover:text-text" href="#pricing">Pricing</a>
				<a class="transition hover:text-text" href="#contact">Contact</a>
			</nav>
		</div>
		<div class="flex flex-wrap items-center justify-between gap-3 border-t border-border/50 pt-6 text-[12px] text-muted">
			<span>&copy; {year} {site.profile.name} &middot; aakrit.seth.ltd</span>
			<span>
				Photos: <a class="underline decoration-border underline-offset-2 hover:text-text" href="https://www.amstelveensnieuwsblad.nl/sport/denksport/89559/zukertort-jeugd-nederlands-kampioen-schaken-voor-clubteams" target="_blank" rel="noopener">Amstelveens Nieuwsblad</a>, <a class="underline decoration-border underline-offset-2 hover:text-text" href="https://www.deutsche-schachjugend.de/2021/dvm-u10/sc-weisse-dame/" target="_blank" rel="noopener">Deutsche Schachjugend</a>
			</span>
		</div>
	</div>
</footer>
