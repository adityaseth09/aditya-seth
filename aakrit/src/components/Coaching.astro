---
import site from '../data/site.json';
---

<section id="coaching" class="border-y border-border/60 bg-surface/50 py-20 sm:py-24" aria-label="Coaching">
	<div class="section-shell">
		<div class="mb-10 max-w-2xl" data-reveal>
			<p class="eyebrow mb-3">Coaching</p>
			<h2 class="font-display text-3xl font-bold tracking-tight text-text sm:text-4xl">A coach who just made the climb himself</h2>
			<p class="mt-3 text-[15px] leading-relaxed text-muted">{site.coach.pitch}</p>
		</div>

		<div class="grid gap-5 lg:grid-cols-[1fr_1fr]">
			<div class="card-surface p-6 sm:p-7" data-reveal>
				<h3 class="font-display text-lg font-bold text-text">Who it's for</h3>
				<ul class="mt-4 grid gap-3">
					{
						site.coach.audience.map((item) => (
							<li class="flex items-start gap-3 text-[14px] leading-relaxed text-muted">
								<span class="mt-0.5 text-accent">&#9679;</span>
								{item}
							</li>
						))
					}
				</ul>
				<h3 class="mt-7 font-display text-lg font-bold text-text">How lessons run</h3>
				<ul class="mt-4 grid gap-3">
					{
						site.coach.format.map((item) => (
							<li class="flex items-start gap-3 text-[14px] leading-relaxed text-muted">
								<span class="mt-0.5 text-accent-2">&#9679;</span>
								{item}
							</li>
						))
					}
				</ul>
			</div>

			<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2" data-reveal>
				{
					site.coach.method.map((item) => (
						<article class="card-surface p-5">
							<span class="flex h-9 w-9 items-center justify-center rounded-lg border border-accent/40 bg-accent-soft text-[16px] text-accent">&#9822;</span>
							<h3 class="mt-3 font-display text-[15px] font-bold text-text">{item.name}</h3>
							<p class="mt-1.5 text-[13px] leading-relaxed text-muted">{item.detail}</p>
						</article>
					))
				}
			</div>
		</div>
	</div>
</section>
