---
import site from '../data/site.json';
---

<section id="pricing" class="py-20 sm:py-24" aria-label="Pricing">
	<div class="section-shell">
		<div class="mb-10 flex flex-wrap items-end justify-between gap-4" data-reveal>
			<div class="max-w-2xl">
				<p class="eyebrow mb-3">Pricing</p>
				<h2 class="font-display text-3xl font-bold tracking-tight text-text sm:text-4xl">Fair prices, serious coaching</h2>
				<p class="mt-3 text-[15px] leading-relaxed text-muted">
					Why so affordable? Aakrit is building his coaching record — early pupils get dedicated 2000-rated coaching at a student-friendly price. {site.booking.note}
				</p>
			</div>
		</div>

		<div class="grid gap-5 md:grid-cols-3">
			{
				site.pricing.map((tier) => (
					<article
						class:list={[
							'card-surface relative flex flex-col p-6 sm:p-7',
							tier.featured && 'border-accent/60 ring-1 ring-accent/30',
						]}
						data-reveal
					>
						{tier.highlight && (
							<span class="absolute -top-3 left-6 rounded-full bg-accent px-3 py-1 font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-background">
								{tier.highlight}
							</span>
						)}
						<h3 class="font-display text-lg font-bold text-text">{tier.name}</h3>
						<p class="mt-3">
							<span class="font-display text-4xl font-extrabold tabular-nums text-text">{tier.price}</span>
							<span class="ml-1.5 text-[13px] text-muted">/ {tier.per}</span>
						</p>
						<ul class="mt-5 grid flex-1 gap-2.5">
							{tier.features.map((feature) => (
								<li class="flex items-start gap-2.5 text-[13.5px] leading-relaxed text-muted">
									<span class="mt-0.5 font-mono text-accent">&#10003;</span>
									{feature}
								</li>
							))}
						</ul>
						<a
							href={site.booking.calendly}
							target="_blank"
							rel="noopener"
							class:list={['mt-6', tier.featured ? 'btn-primary' : 'btn-ghost']}
						>
							{tier.cta}
						</a>
					</article>
				))
			}
		</div>

		<p class="mt-6 text-center font-mono text-[11px] text-muted">
			Scheduling via the booking calendar &middot; payments confirmed when you book &middot; cancel anytime
		</p>
	</div>
</section>
