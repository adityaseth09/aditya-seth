---
import site from '../data/site.json';

const hasWhatsApp = Boolean(site.profile.whatsapp);
---

<section id="contact" class="relative overflow-hidden border-t border-border/60 py-20 sm:py-24" aria-label="Contact">
	<div class="board-pattern pointer-events-none absolute inset-0 opacity-25" aria-hidden="true"></div>
	<div class="section-shell relative grid gap-10 lg:grid-cols-2">
		<div data-reveal>
			<p class="eyebrow mb-3">Contact</p>
			<h2 class="font-display text-3xl font-bold tracking-tight text-text sm:text-4xl">Ask anything — in English, German or Hindi</h2>
			<p class="mt-3 max-w-md text-[15px] leading-relaxed text-muted">
				Not sure if it's the right fit? Send a question first — or jump straight to the free 20-minute trial lesson. No payment, no commitment.
			</p>
			<div class="mt-7 flex flex-wrap gap-3">
				<a href={site.booking.calendly} target="_blank" rel="noopener" class="btn-primary">Book the free trial</a>
				<a href={`mailto:${site.profile.email}`} class="btn-ghost">
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="3" /><path d="m3 6 9 7 9-7" /></svg>
					{site.profile.email}
				</a>
				{
					hasWhatsApp && (
						<a href={site.profile.whatsapp} target="_blank" rel="noopener" class="btn-ghost">WhatsApp</a>
					)
				}
			</div>
		</div>

		<div class="card-surface p-6 sm:p-7" data-reveal>
			<h3 class="font-display text-lg font-bold text-text">Verify &amp; follow</h3>
			<p class="mt-1.5 text-[13px] text-muted">Every claim on this site can be checked at the source:</p>
			<ul class="mt-4 grid gap-2.5">
				<li><a class="flex items-center justify-between gap-3 rounded-lg border border-border/70 bg-elevated/50 px-4 py-3 text-[13.5px] font-medium text-text transition hover:border-accent/50" href={site.links.fide} target="_blank" rel="noopener">FIDE rating profile <span class="font-mono text-[11px] text-muted">34604812 &#8599;</span></a></li>
				<li><a class="flex items-center justify-between gap-3 rounded-lg border border-border/70 bg-elevated/50 px-4 py-3 text-[13.5px] font-medium text-text transition hover:border-accent/50" href={site.links.chessever} target="_blank" rel="noopener">Tournament history <span class="font-mono text-[11px] text-muted">ChessEver &#8599;</span></a></li>
				<li><a class="flex items-center justify-between gap-3 rounded-lg border border-border/70 bg-elevated/50 px-4 py-3 text-[13.5px] font-medium text-text transition hover:border-accent/50" href={site.links.knsb} target="_blank" rel="noopener">Dutch national rating <span class="font-mono text-[11px] text-muted">KNSB &#8599;</span></a></li>
				<li><a class="flex items-center justify-between gap-3 rounded-lg border border-border/70 bg-elevated/50 px-4 py-3 text-[13.5px] font-medium text-text transition hover:border-accent/50" href={site.links.berlinYouth} target="_blank" rel="noopener">Berlin youth chess <span class="font-mono text-[11px] text-muted">SJiB &#8599;</span></a></li>
			</ul>
		</div>
	</div>
</section>
