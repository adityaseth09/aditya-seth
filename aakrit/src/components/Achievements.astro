---
import site from '../data/site.json';

const featured = site.headlineAchievements;
const rest = site.achievements;
const trophies = site.trophies;
---

<section id="achievements" class="border-y border-border/60 bg-surface/50 py-20 sm:py-24" aria-label="Achievements">
	<div class="section-shell">
		<div class="mb-10 flex flex-wrap items-end justify-between gap-4" data-reveal>
			<div class="max-w-2xl">
				<p class="eyebrow mb-3">Verified record</p>
				<h2 class="font-display text-3xl font-bold tracking-tight text-text sm:text-4xl">Trophies you can check</h2>
				<p class="mt-3 text-[15px] leading-relaxed text-muted">
					Chess parents check ratings — so every result below links to its official source. What you see is exactly what the federations publish.
				</p>
			</div>
			<a href={site.links.fide} target="_blank" rel="noopener" class="btn-ghost">FIDE profile &#8599;</a>
		</div>

		<div class="grid gap-5 md:grid-cols-3">
			{
				featured.map((item) => (
					<article class="card-surface relative overflow-hidden p-6" data-reveal>
						<div class="board-pattern absolute inset-0 opacity-30" aria-hidden="true" />
						<div class="relative">
							<span class="chip-gold">{item.year}</span>
							<h3 class="mt-3 font-display text-xl font-bold text-text">{item.title}</h3>
							<p class="mt-2 text-[14px] leading-relaxed text-muted">{item.detail}</p>
							<a href={item.source} target="_blank" rel="noopener" class="mt-4 inline-flex items-center gap-1 font-mono text-[11px] uppercase tracking-[0.14em] text-accent hover:underline">
								Verified source &#8599;
							</a>
						</div>
					</article>
				))
			}
		</div>

		<div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{
				rest.map((item) => (
					<article class="card-surface p-5" data-reveal>
						<div class="flex items-baseline justify-between gap-3">
							<h3 class="font-display text-[15px] font-bold leading-snug text-text">{item.title}</h3>
							<span class="shrink-0 font-mono text-[11px] text-muted">{item.year}</span>
						</div>
						<p class="mt-2 text-[13px] leading-relaxed text-muted">{item.detail}</p>
						<a href={item.source} target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-1 font-mono text-[10px] uppercase tracking-[0.14em] text-accent hover:underline">
							Source &#8599;
						</a>
					</article>
				))
			}
		</div>

		{
			trophies.length > 0 && (
				<div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
					{trophies.map((item: any) => (
						<article class="card-surface p-5" data-reveal>
							<div class="flex items-baseline justify-between gap-3">
								<h3 class="font-display text-[15px] font-bold leading-snug text-text">{item.title}</h3>
								<span class="shrink-0 font-mono text-[11px] text-muted">{item.year}</span>
							</div>
							<p class="mt-2 text-[13px] leading-relaxed text-muted">{item.detail}</p>
						</article>
					))}
				</div>
			)
		}
	</div>
</section>
