---
import site from '../data/site.json';
import ThemeToggle from './ThemeToggle.astro';

const navLinks = [
	{ href: '#ratings', label: 'Ratings' },
	{ href: '#achievements', label: 'Achievements' },
	{ href: '#journey', label: 'Journey' },
	{ href: '#coaching', label: 'Coaching' },
	{ href: '#pricing', label: 'Pricing' },
	{ href: '#faq', label: 'FAQ' },
	{ href: '#contact', label: 'Contact' },
];
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-border/60 bg-background/80 backdrop-blur-md">
	<div class="section-shell flex h-16 items-center justify-between gap-4">
		<a href="#main" class="flex items-center gap-2.5 font-display text-[15px] font-bold tracking-tight text-text">
			<span class="flex h-8 w-8 items-center justify-center rounded-lg border border-border bg-elevated text-[17px] leading-none text-accent">♞</span>
			<span>{site.profile.name}</span>
		</a>
		<nav class="hidden items-center gap-6 text-[13px] font-medium text-muted md:flex" aria-label="Primary">
			{navLinks.map((link) => (
				<a href={link.href} class="transition hover:text-text">{link.label}</a>
			))}
		</nav>
		<div class="flex items-center gap-2.5">
			<ThemeToggle />
			<a
				href={site.booking.calendly}
				target="_blank"
				rel="noopener"
				class="hidden rounded-full border border-accent/50 bg-accent-soft px-4 py-1.5 text-[13px] font-semibold text-accent transition hover:border-accent sm:inline-flex"
			>
				Free trial lesson
			</a>
			<button
				id="nav-menu-btn"
				class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-border bg-surface text-muted md:hidden"
				aria-label="Open menu"
				aria-expanded="false"
			>
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
			</button>
		</div>
	</div>
	<nav id="nav-mobile" class="hidden border-t border-border/60 bg-surface px-6 pb-5 pt-3 md:hidden" aria-label="Mobile">
		<ul class="grid gap-1">
			{navLinks.map((link) => (
				<li><a href={link.href} class="block rounded-lg px-3 py-2 text-sm font-medium text-muted transition hover:bg-elevated hover:text-text">{link.label}</a></li>
			))}
			<li class="mt-2">
				<a href={site.booking.calendly} target="_blank" rel="noopener" class="btn-primary w-full">Free trial lesson</a>
			</li>
		</ul>
	</nav>
</header>

<script>
	document.getElementById('nav-menu-btn')?.addEventListener('click', (event) => {
		const button = event.currentTarget as HTMLButtonElement;
		const menu = document.getElementById('nav-mobile');
		if (!menu) return;
		const open = menu.classList.toggle('hidden') === false;
		button.setAttribute('aria-expanded', String(open));
	});
</script>
